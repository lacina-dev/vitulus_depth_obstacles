<launch>
  <!-- Replaces rtabmap_docker obstacles_detection.launch (container RTABMAP_OBSTACLES): same inputs (the
       RTABMAP_ODOM_SYNC outputs), same output topics, one process. -->
  <arg name="depth" default="/rtabmap/depth/image_out"/>
  <arg name="camera_info" default="/rtabmap/rgb/camera_info_out"/>
  <!-- local traversability map from the clouds below (package vitulus_traversability). Off unless the robot sets
       VITULUS_TRAVERSABILITY=true (~/.bashrc, sourced by vitulus.service): a robot without the package stays as is -->
  <arg name="traversability" default="$(optenv VITULUS_TRAVERSABILITY false)"/>
  <node pkg="vitulus_depth_obstacles" type="depth_obstacles" name="depth_obstacles" output="log" respawn="true">
    <rosparam command="load" file="$(find vitulus_depth_obstacles)/config/d435_ros1.yaml"/>
    <remap from="depth/image" to="$(arg depth)"/>
    <remap from="depth/camera_info" to="$(arg camera_info)"/>
  </node>
  <!-- the same node name as a standalone start of traversability.launch: the ROS master shuts the older instance
       down when this one registers, so the two never run side by side -->
  <include if="$(arg traversability)" file="$(find vitulus_traversability)/launch/traversability.launch">
    <arg name="respawn" value="true"/>
  </include>
</launch>
